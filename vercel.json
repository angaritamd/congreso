{
  "version": 2,
  "buildCommand": "echo 'static'",
  "outputDirectory": ".",
  "routes": [
    { "src": "/images/(.*)", "dest": "/images/$1" },
    { "src": "/docs/(.*)", "dest": "/docs/$1" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/taller", "dest": "/taller.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
